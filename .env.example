# Azure OpenAI resource endpoint and API key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-api-key
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Local development defaults. Docker Compose overrides the host and broker URLs.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ai_regulations
CHROMA_PERSIST_DIR=chroma_data
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Application
BACKEND_PORT=8080
RETRIEVAL_TOP_K=6
AGENT_MAX_STEPS=6
CORS_ORIGINS=http://localhost,http://localhost:5173
DOCS_DIR=document
INGESTION_DIR=ingestion

# Change this before exposing the application beyond local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
